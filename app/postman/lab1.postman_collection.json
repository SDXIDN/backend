      "name": "0. Tokens (Keycloak, password grant)",
      "item": [
        {
          "name": "Token: user (USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "booking-app"
                },
                {
                  "key": "client_secret",
                  "value": "booking-secret"
                },
                {
                  "key": "username",
                  "value": "user"
                },
                {
                  "key": "password",
                  "value": "user"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/course/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
